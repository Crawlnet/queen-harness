# The model: any OpenAI-compatible chat completions API with tool calls (required)
LLM_API_KEY=
LLM_MODEL=
# default https://openrouter.ai/api/v1
LLM_BASE_URL=
# reasoning before the answer: off | low | high | max (default high)
LLM_THINKING=

# Solana reads. With nothing set, the public RPC; holder reads on big coins need a real endpoint.
# A comma list of RPC URLs, or Helius keys alone
SOLANA_RPC_URLS=
HELIUS_API_KEYS=
# Your Helius key (or a comma list of your own keys) for the launch read (sol_launch, call_frontrun,
# caller_side_wallets): getTransactionsForAddress
HELIUS_LAUNCH_KEYS=

# Posts on X and web search through Grok on OpenRouter (social_mentions, news_pages, ct_calls).
# Unset: LLM_API_KEY when LLM_BASE_URL is OpenRouter's
TOOLS_XSEARCH_KEY=
# The CT radar's own X reader (optional; else Grok)
TOOLS_TWITTERAPI_KEY=

# The data hub (hub_find, hub_call, hub_rpc): labels, defi positions, 153 chains' RPC
API_HUB_KEY=
# GitHub's API for the larp check (5,000 calls an hour instead of 60)
GITHUB_TOKEN=

# The narrative services' folder (services/: meme_narrative, meme_metas, meme_runners, x_ideas)
NARRATIVE_DIR=

# Jev, the intent model read where code is unsure (an OpenRouter key; optional)
JEV_KEY=
# The token the harness speaks for, and what it says about itself (optional)
OWN_MINT=
ABOUT_FILE=

# Where the harness keeps its SQLite file (caches, call counts, wallet memory); default ./data
DATA_DIR=
# The HTTP server (npm run serve)
PORT=8790
HOST=127.0.0.1

# Optional tunables, shown with their defaults: uncomment to change one.
# The model
# LLM_EXTRA_BODY=               JSON merged into every model request (provider options; a null drops a field)
# LLM_MAX_TOKENS=4500           the answer's output tokens (4500 at least)
# LLM_REASONING_TOKENS=2000     extra output tokens for the reasoning when thinking is on
# LLM_TEMPERATURE=0.6
# LLM_TIMEOUT_MS=180000         one model call, retries included
# The harness
# HARNESS_ANSWER_MS=240000      one whole answer, its calls and the write included (30000 at least)
# HARNESS_IN_FLIGHT_MAX=4       answers the HTTP server runs at once; more get a 429
# HARNESS_QUIET=                1: no JSON log lines on stderr
# HARNESS_LOG=                  1: the CLI prints the JSON log lines too
# The tools layer
# SOLANA_RPC_URL=               one more RPC URL, behind SOLANA_RPC_URLS and the Helius keys
# TOOLS_MAX_CALLS_PER_ANSWER=12 function calls one answer may make
# TOOLS_TIMEOUT_MS=8000         one function call's timeout
# TOOLS_CACHE_MAX=500           function results kept in the cache
# TOOLS_DISABLE=                a comma list of function names left out
# TOOLS_GECKO_PER_MIN=10        GeckoTerminal calls a minute (its free API's limit)
# TOOLS_SECURITY=               off: no RugCheck and GoPlus risk flags
# TOOLS_XSEARCH=                off: no posts search on X
# TOOLS_XSEARCH_MODEL=x-ai/grok-4.3
# TOOLS_XSEARCH_DAILY_CALLS=100
# TOOLS_NEWS=                   off: no web search
# TOOLS_NEWS_MODEL=x-ai/grok-4.3
# TOOLS_NEWS_DAILY_CALLS=100
# TOOLS_HUB=                    off: no data hub
# TOOLS_HUB_DAILY_CALLS=20000
# TOOLS_HUB_DAILY_CREDITS=3000  the hub's credit-billed routes a day (the on-chain labels)
# TOOLS_CTRADAR=                off: no CT calls radar
# TOOLS_CTRADAR_MIN=            minutes between the radar's reads (5 on twitterapi.io, 20 on Grok)
# TOOLS_CTRADAR_MIN_FOLLOWERS=1000
# TOOLS_CTRADAR_TOP_MIN=30      minutes between Grok's top calls reads
# TOOLS_REDACT_TERMS=           a comma list of terms the redaction guard removes from every output
# TOOLS_REDACT_KEEP=            ordinary words that hold a term and stay
